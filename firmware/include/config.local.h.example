/**
 * PanzerNavSystem - Local Hardware & Network Overrides
 *
 * Copy this file to "config.local.h" to customize hardware profiles,
 * actuator limits, calibration, or Wi-Fi credentials.
 * "config.local.h" is ignored by git.
 */

#ifndef CONFIG_LOCAL_H
#define CONFIG_LOCAL_H

// =============================================================================
// 1. WI-FI ACCESS POINT (PRIMARY / DEFAULT MODE)
// =============================================================================
// The ESP-12E broadcasts its own local Wi-Fi network. No internet is required.
// Change these values to personalize your tank's network.
// A private password (minimum 8 characters) is required to prevent unauthorized access.

// #define WIFI_AP_SSID           "MyTank-AP"
// #define WIFI_AP_PASS           "mysecretpass123"
// #define WIFI_AP_CHANNEL        1

// Custom Access Point IP address (defaults to 192.168.4.1)
