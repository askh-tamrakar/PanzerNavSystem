// =============================================================================
// 2. HARDWARE PROFILE SELECTION
// =============================================================================
// Options:
//   PROFILE_UNCONFIRMED         (Default: locks out propulsion until verified)
//   PROFILE_A_DC_MOTORS         (4 DC Motors via 2x L298N + 4 auxiliary servos)
//   PROFILE_B_PROPULSION_SERVOS (4 Propulsion Servos + 4 auxiliary servos, 2x L298N unused)

// #define ACTIVE_HARDWARE_PROFILE PROFILE_A_DC_MOTORS

// --- Profile B: Propulsion Servo Type & Calibration ---
